---
import { SITE } from "@/config";

const comments = SITE.comments;
const shouldRender =
  comments.enabled &&
  comments.repo.trim() !== "" &&
  comments.repoId.trim() !== "" &&
  comments.category.trim() !== "" &&
  comments.categoryId.trim() !== "";
---

{
  shouldRender && (
    <section
      id="comments"
      class="mt-8"
      data-pagefind-ignore
      data-repo={comments.repo}
      data-repo-id={comments.repoId}
      data-category={comments.category}
      data-category-id={comments.categoryId}
      data-mapping={comments.mapping}
      data-strict={comments.strict}
      data-reactions-enabled={comments.reactionsEnabled}
      data-emit-metadata={comments.emitMetadata}
      data-input-position={comments.inputPosition}
      data-lang={comments.lang}
      aria-label="评论"
    />
  )
}

<script is:inline data-astro-rerun>
  function getGiscusTheme() {
    return document.documentElement.dataset.theme === "dark" ? "dark" : "light";
  }

  function syncGiscusTheme() {
    const container = document.querySelector("#comments");
    const theme = getGiscusTheme();
    const script = container?.querySelector(
      'script[src="https://giscus.app/client.js"]'
    );
    if (script) script.dataset.theme = theme;
    container
      ?.querySelector("iframe.giscus-frame")
      ?.contentWindow?.postMessage(
        { giscus: { setConfig: { theme } } },
        "https://giscus.app"
      );
  }

  function loadGiscus() {
    const container = document.querySelector("#comments");

    if (!container) return;
    if (
      container.querySelector(
        'iframe.giscus-frame, script[src="https://giscus.app/client.js"]'
      )
    ) {
      syncGiscusTheme();
      return;
    }

    container.replaceChildren();

    const script = document.createElement("script");
    script.src = "https://giscus.app/client.js";
    script.dataset.repo = container.dataset.repo;
    script.dataset.repoId = container.dataset.repoId;
    script.dataset.category = container.dataset.category;
    script.dataset.categoryId = container.dataset.categoryId;
    script.dataset.mapping = container.dataset.mapping;
    script.dataset.strict = container.dataset.strict;
    script.dataset.reactionsEnabled = container.dataset.reactionsEnabled;
    script.dataset.emitMetadata = container.dataset.emitMetadata;
    script.dataset.inputPosition = container.dataset.inputPosition;
    script.dataset.theme = getGiscusTheme();
    script.dataset.lang = container.dataset.lang;
    script.crossOrigin = "anonymous";
    script.async = true;

    container.appendChild(script);
  }

  loadGiscus();

  if (!window.__giscusPageLoadBound) {
    document.addEventListener("astro:page-load", loadGiscus);
    // Capture iframe load so theme changes during loading are applied too.
    document.addEventListener(
      "load",
      event => {
        if (
          event.target instanceof HTMLIFrameElement &&
          event.target.matches("#comments iframe.giscus-frame")
        ) {
          syncGiscusTheme();
        }
      },
      true
    );
    // The root element survives Astro navigation; bind only once per document.
    new MutationObserver(syncGiscusTheme).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });
    window.__giscusPageLoadBound = true;
  }
</script>
